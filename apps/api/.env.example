TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

APP_KEY=
APP_URL=http://${HOST}:${PORT}

DATABASE_URL=postgres://stashit:stashit@localhost:5435/stashit

REDIS_URL=redis://localhost:6385

# LLM enrichment (Vercel AI SDK)
# Provider one of: anthropic | openai | google | openrouter
STASHIT_LLM_PROVIDER=anthropic
STASHIT_LLM_MODEL=claude-sonnet-4-5
STASHIT_LLM_API_KEY=
